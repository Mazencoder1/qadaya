@model List<Committee>
@{
    ViewData["Title"] = "اللجان";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">عدد اللجان: @Model.Count</p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-gold">+ إضافة لجنة</a>
    }
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-4">
            <div class="panel h-100">
                <div class="d-flex justify-content-between">
                    <h5 class="mb-1">@c.Name</h5>
                </div>
                <span class="badge badge-type mb-2" style="width:fit-content;">@c.Type</span>
                <p class="text-muted small mb-2">@c.Description</p>
                <div class="d-flex justify-content-between small text-muted mb-3">
                    <span>👥 @c.Members.Count أعضاء</span>
                    <span>📁 @c.Cases.Count قضية</span>
                </div>
                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary w-100">عرض التفاصيل</a>
            </div>
        </div>
    }
</div>
