@model Committee
@{
    ViewData["Title"] = "حذف اللجنة";
}

<div class="panel" style="max-width:600px;">
    <h5 class="mb-3">تأكيد حذف اللجنة</h5>
    <p>هل أنت متأكد أنك تريد حذف لجنة "<strong>@Model.Name</strong>"؟ لا يمكن التراجع عن هذا الإجراء.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">نعم، حذف اللجنة</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
    </form>
</div>
